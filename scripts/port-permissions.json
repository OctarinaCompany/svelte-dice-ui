{
	"$comment": "Optional scoped-permission profile, used by `port-components.ps1 -PermissionProfile allowlist`. It is merged on top of headless-settings.json semantics by the orchestrator (which passes BOTH files' effects: this file is passed as --settings and repeats the hook/plugin neutralisation). Honest limitation: Bash permission rules are prefix/glob matchers over the command string and are trivially bypassed by chaining or by `pwsh -c`. Treat the deny list as a guardrail against accidents, not as a security boundary. The real safety net is the per-component commit + `port/<slug>` tag, which makes any damage one `git reset --hard` away.",

	"hooks": {},
	"enabledPlugins": {},
	"enableAllProjectMcpServers": false,
	"includeCoAuthoredBy": false,

	"env": {
		"CI": "1",
		"NO_COLOR": "1",
		"FORCE_COLOR": "0",
		"DO_NOT_TRACK": "1",
		"npm_config_yes": "true"
	},

	"permissions": {
		"defaultMode": "acceptEdits",
		"allow": [
			"Read",
			"Edit",
			"Write",
			"Glob",
			"Grep",
			"TodoWrite",
			"WebFetch",
			"WebSearch",
			"Task",
			"Bash(pnpm install*)",
			"Bash(pnpm add*)",
			"Bash(pnpm remove*)",
			"Bash(pnpm run*)",
			"Bash(pnpm exec*)",
			"Bash(pnpm test*)",
			"Bash(pnpm dlx shadcn-svelte@latest*)",
			"Bash(npx shadcn-svelte@latest*)",
			"Bash(npx sv*)",
			"Bash(node*)",
			"Bash(tsc*)",
			"Bash(git status*)",
			"Bash(git diff*)",
			"Bash(git log*)",
			"Bash(git show*)",
			"Bash(git rev-parse*)",
			"Bash(git ls-files*)",
			"Bash(pwsh -NoProfile -File .specify/scripts/powershell/*)",
			"Bash(powershell -NoProfile -File .specify/scripts/powershell/*)",
			"Bash(ls*)",
			"Bash(cat*)",
			"Bash(head*)",
			"Bash(tail*)",
			"Bash(rg*)",
			"Bash(find*)",
			"Bash(wc*)",
			"Bash(mkdir*)"
		],
		"deny": [
			"Bash(git commit*)",
			"Bash(git add*)",
			"Bash(git push*)",
			"Bash(git reset*)",
			"Bash(git checkout*)",
			"Bash(git switch*)",
			"Bash(git branch*)",
			"Bash(git rebase*)",
			"Bash(git merge*)",
			"Bash(git stash*)",
			"Bash(git tag*)",
			"Bash(git clean*)",
			"Bash(gh *)",
			"Bash(npm publish*)",
			"Bash(pnpm publish*)",
			"Bash(pnpm dev*)",
			"Bash(npm run dev*)",
			"Bash(vite dev*)",
			"Bash(rm -rf*)",
			"Bash(Remove-Item*)",
			"Bash(curl*)",
			"Bash(Invoke-WebRequest*)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Edit(./.port-state.json)",
			"Write(./.port-state.json)",
			"Edit(./scripts/**)",
			"Write(./scripts/**)",
			"Edit(./.claude/settings*.json)",
			"Edit(./.specify/scripts/**)",
			"Edit(./.specify/templates/**)",
			"Edit(./.reference/**)",
			"Write(./.reference/**)"
		]
	}
}
